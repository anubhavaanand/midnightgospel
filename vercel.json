# Vercel Deployment Configuration
# Learn more: https://vercel.com/docs/concepts/projects/project-configuration

{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "env": [
    {
      "key": "VITE_GOOGLE_API_KEY",
      "value": "your_google_gemini_api_key",
      "type": "sensitive"
    },
    {
      "key": "VITE_GA_ID",
      "value": "G-XXXXXXXXXX"
    },
    {
      "key": "VITE_ENV",
      "value": "production"
    }
  ],
  "regions": [
    "iad1",
    "sfo1",
    "lhr1",
    "syd1"
  ],
  "buildCache": {
    "node_modules": true,
    ".next": true
  },
  "functions": {
    "api/health.ts": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/old-page",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
